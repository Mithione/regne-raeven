@model RoomModel
@{
    ViewData["Title"] = "Mit værelse";
    ViewData["Nav"] = "vaerelse";
    var p = Model.Profile;
    var layout = Model.Layout;
    var level = Model.Level;
    var owned = RoomCatalog.Items.Count(i => !i.IsFree && Model.Bought.Contains(i.Id));
    var forSale = RoomCatalog.Items.Count(i => !i.IsFree);
    var inBox = RoomCatalog.Items.Where(i => RoomLayouts.IsPlaceable(i) && RoomCatalog.Owns(i, Model.Bought) && !layout.Contains(i.Id)).ToList();
    var fox = AvatarArt.Svg((Unlocks.Find(p.Avatar) ?? Unlocks.Avatars[0]).Id);
}
<div class="topbar">
    <div>
        <h1>🛏️ @p.Name@(p.Name.EndsWith('s') ? "'" : "s") rævehule</h1>
        <div class="muted">Træk tingene rundt, vend og drej dem, og læg dem foran eller bagved hinanden. Tryk på vinduet for nat og dag.</div>
    </div>
    <span class="gold-badge">🪙 @p.Gold guld</span>
</div>

<div class="card room-card" data-room>
    @Html.Raw(RoomArt.Room(layout, fox))
    <div class="room-toolbar" data-toolbar>
        <span class="room-hint" data-hint>👆 Tryk på en ting for at flytte den</span>
        <span class="room-selected hidden" data-selected-name></span>
        <div class="room-tools">
            <button type="button" class="tool" data-act="left" title="Drej mod venstre" disabled>↺</button>
            <button type="button" class="tool" data-act="right" title="Drej mod højre" disabled>↻</button>
            <button type="button" class="tool" data-act="straight" title="Ret op" disabled>⟂</button>
            <button type="button" class="tool" data-act="flip" title="Vend" disabled>⇋ Vend</button>
            <button type="button" class="tool" data-act="front" title="Læg forrest" disabled>⬆ Frem</button>
            <button type="button" class="tool" data-act="back" title="Læg bagerst" disabled>⬇ Tilbage</button>
            <button type="button" class="tool" data-act="box" title="Læg i kassen" disabled>📦 I kassen</button>
        </div>
        <span class="room-saved small muted" data-saved></span>
    </div>
</div>

<div class="card mt" id="kasse">
    <div class="row between">
        <h2 style="margin:0">📦 Kassen</h2>
        <span class="muted small">Ting du ejer, men som ikke står i værelset</span>
    </div>
    <div class="box-items mt" data-box>
        @if (inBox.Count == 0) { <span class="muted small" data-box-empty>Kassen er tom.</span> }
        @foreach (var item in inBox)
        {
            <form method="post" action="/vaerelse/placer" class="box-item">
                <input type="hidden" name="id" value="@item.Id">
                <button type="submit" title="Sæt @item.Name ind i værelset">
                    <span class="thumb">@Html.Raw(RoomArt.Thumb(item))</span>
                    <span>@item.Name</span>
                    <span class="small muted">Sæt ind</span>
                </button>
            </form>
        }
    </div>
</div>

<div class="card mt">
    <div class="row between">
        <h2 style="margin:0">🛒 Butikken</h2>
        <span class="muted small">@owned af @forSale ting købt · du tjener 1 guld for hver 4 XP</span>
    </div>
    <div class="tabs mt" data-room-tabs>
        @foreach (var s in RoomCatalog.Slots)
        {
            <button type="button" data-tab="@s.Slot">@s.Icon @s.Name</button>
        }
    </div>
    @foreach (var s in RoomCatalog.Slots)
    {
        <section class="hidden" data-panel="@s.Slot" id="@s.Slot">
            <div class="shop">
                @foreach (var item in RoomCatalog.InSlot(s.Slot))
                {
                    var own = RoomCatalog.Owns(item, Model.Bought);
                    var placeable = RoomLayouts.IsPlaceable(item);
                    var inUse = placeable ? layout.Contains(item.Id) : (layout.Wall == item.Id || layout.Bedding == item.Id);
                    var check = RoomCatalog.CanBuy(item, p.Gold, level, Model.Bought);
                    <div class="shop-item @(inUse ? "in-use" : "") @(check == RoomCatalog.BuyCheck.NeedsLevel ? "locked-s" : "")" title="@item.Description">
                        <div class="thumb">@Html.Raw(RoomArt.Thumb(item))</div>
                        <b>@item.Name</b>
                        <span class="small muted">@item.Description</span>
                        @if (inUse && placeable)
                        {
                            <span class="badge green">✓ I dit værelse</span>
                            <form method="post" action="/vaerelse/kasse"><input type="hidden" name="id" value="@item.Id"><button class="btn ghost small" type="submit">📦 Læg i kassen</button></form>
                        }
                        else if (inUse)
                        {
                            <span class="badge green">✓ Bruges nu</span>
                        }
                        else if (own)
                        {
                            <form method="post" action="/vaerelse/placer"><input type="hidden" name="id" value="@item.Id"><button class="btn secondary small" type="submit">@(placeable ? "Sæt ind" : "Brug den")</button></form>
                        }
                        else if (check == RoomCatalog.BuyCheck.NeedsLevel)
                        {
                            <span class="price">🪙 @item.Price</span>
                            <span class="small muted">🔒 Fra level @item.Level</span>
                        }
                        else if (check == RoomCatalog.BuyCheck.NotEnoughGold)
                        {
                            <span class="price">🪙 @item.Price</span>
                            <span class="small muted">Mangler @(item.Price - p.Gold) guld</span>
                        }
                        else
                        {
                            <form method="post" action="/vaerelse/koeb"><input type="hidden" name="id" value="@item.Id"><button class="btn small" type="submit">Køb for 🪙 @item.Price</button></form>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

<div class="card soft small mt">
    <b>Sådan tjener du guld</b>
    <ul style="padding-left:18px;margin:6px 0 0">
        <li>Hver gang du får XP, får du også guld: 1 guld for hver 4 XP.</li>
        <li>Svære opgaver, dagens bonus, dage i træk og 10-finger giver mest.</li>
        <li>Guld kan kun tjenes med opgaver – aldrig købes for rigtige penge.</li>
    </ul>
</div>

@section Scripts {
<script src="@Ui.Assets/js/room.js?v=1"></script>
<script>rrRoom.init(document.querySelector('[data-room]'));</script>
<script>
(function () {
  const tabs = document.querySelector('[data-room-tabs]');
  const show = slot => {
    tabs.querySelectorAll('button').forEach(b => b.classList.toggle('on', b.dataset.tab === slot));
    document.querySelectorAll('[data-panel]').forEach(p => p.classList.toggle('hidden', p.dataset.panel !== slot));
  };
  tabs.addEventListener('click', e => { const b = e.target.closest('button[data-tab]'); if (b) { show(b.dataset.tab); history.replaceState(null, '', '#' + b.dataset.tab); } });
  const fromHash = location.hash.slice(1);
  show(tabs.querySelector(`[data-tab="${fromHash}"]`) ? fromHash : 'Wall');
})();
</script>
}
