@model RuleTopic
@{
    var t = Model.Info;
    ViewData["Title"] = t.Name;
    ViewData["Nav"] = "regler";
    var speech = SpeechText.ForRule(Model);
}
<div class="crumbs"><a href="/regler">Regneregler</a> ›</div>
<div class="topbar">
    <div class="row">
        <span class="tile" style="--c:@t.Color;padding:0;border:0;box-shadow:none;background:none"><span class="sym">@t.Icon</span></span>
        <h1 style="margin:0">@t.Name</h1>
    </div>
    @if (t.InGame)
    {
        <form method="post" action="/spil/traen" class="inline">
            <input type="hidden" name="emne" value="@t.Slug">
            <input type="hidden" name="svaerhed" value="1">
            <button class="btn" type="submit">🎮 Træn @t.Name.ToLowerInvariant()</button>
        </form>
    }
</div>

<div class="split">
    <div class="card" data-rule-speech>
        <div class="row between hidden" data-speak-ui style="margin-bottom:10px">
            <button type="button" class="btn secondary" data-speak-all>🔊 Læs reglen op</button>
            <a class="small" href="/profiler/rediger#oplaesning">Stemme og tempo</a>
        </div>
        <div class="tip hidden" data-speak-note></div>
        <p style="font-size:1.12rem" data-speak="@speech[0].Text">@Model.Intro</p>
        @for (var i = 0; i < Model.Sections.Count; i++)
        {
            var s = Model.Sections[i];
            <div class="rule-section" data-speak="@speech[i + 1].Text">
                <h3 class="row between">@s.Heading <button type="button" class="speak-one hidden" data-speak-ui data-speak-one title="Læs dette afsnit op">🔊</button></h3>
                <p>@s.Text</p>
                @if (s.Example is { Count: > 0 } ex)
                {
                    <pre class="opstilling">@string.Join("\n", ex)</pre>
                }
                @if (s.Tip is not null) { <div class="tip">💡 @s.Tip</div> }
            </div>
        }
        <div class="remember" data-speak="@speech[^1].Text">🦊 Husk: @Model.Remember</div>
    </div>
    <div class="stack">
        <div class="card soft">
            <h3>Prøv et eksempel</h3>
            <form method="get" action="/regler/trin">
                <input type="text" name="udtryk" placeholder="Skriv et regnestykke" autocomplete="off">
                <button class="btn small mt" type="submit">Vis trin for trin</button>
            </form>
        </div>
        <div class="card">
            <h3>Andre emner</h3>
            <div class="chips">
                @foreach (var other in RuleBook.All.Where(r => r.Topic != Model.Topic))
                {
                    @Ui.Chip(other.Info, "/regler/" + other.Info.Slug)
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>rrSpeech.rulePage(document.querySelector('[data-rule-speech]'));</script>
}
