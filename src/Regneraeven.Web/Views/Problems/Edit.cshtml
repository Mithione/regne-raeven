@model ProblemForm
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "Gem en opgave" : "Ret opgave";
    ViewData["Nav"] = "opgaver";
    var chosen = Model.Topics ?? [];
}
<div class="crumbs"><a href="/opgaver">Mine opgaver</a> ›</div>
<div class="topbar"><h1>@ViewData["Title"]</h1></div>

<form method="post" action="@(isNew ? "/opgaver/ny" : $"/opgaver/{Model.Id}/rediger")" class="card" style="max-width:820px" data-problem-form>
    <div class="stack">
        <div>
            <div class="row between" style="margin-bottom:6px">
                <label class="field" for="Text" style="margin:0">Opgaven</label>
                <button type="button" class="btn secondary small mic-btn hidden" data-mic title="Indtal opgaven">🎤 Indtal</button>
            </div>
            <textarea id="Text" name="Text" required maxlength="2000" placeholder="Skriv regnestykket (fx 3/4 + 1/6) eller hele tekststykket fra bogen – eller tryk 🎤 Indtal og sig det" autofocus>@Model.Text</textarea>
            <div class="mic-status hidden" data-mic-status></div>
            <div class="heard hidden" data-heard>
                <span>🦊 Ræven hørte et regnestykke:</span>
                <b class="heard-math" data-heard-math></b>
                <button type="button" class="btn small" data-heard-use>Brug det</button>
            </div>
            <div class="field-help">Ræven foreslår tags ud fra det, du skriver eller siger ✨</div>
        </div>
        <div>
            <span class="field" style="display:block;font-weight:700;margin-bottom:6px">Hvilken slags opgave er det?</span>
            <div class="topic-pick">
                @foreach (var t in TopicCatalog.All)
                {
                    <label>
                        <input type="checkbox" name="Topics" value="@t.Slug" checked="@chosen.Contains(t.Slug)" data-topic="@t.Slug">
                        <span class="chip topic" style="--c:@t.Color"><span class="sym">@t.Icon</span>@t.Short</span>
                    </label>
                }
            </div>
        </div>
        <div>
            <label class="field" for="OwnTags">Egne tags <span class="muted small">(valgfrit – adskil med komma)</span></label>
            <input type="text" id="OwnTags" name="OwnTags" value="@Model.OwnTags" placeholder="Fx lektier uge 47, matematikbogen s. 34" autocomplete="off">
        </div>
        <div>
            <label class="field" for="Note">Note <span class="muted small">(valgfrit)</span></label>
            <textarea id="Note" name="Note" maxlength="2000" style="min-height:70px" placeholder="Fx hvad du synes er svært">@Model.Note</textarea>
        </div>
        <div class="row">
            <button class="btn big" type="submit">@(isNew ? "Gem opgaven" : "Gem ændringer")</button>
            <a class="btn ghost" href="@(isNew ? "/opgaver" : $"/opgaver/{Model.Id}")">Annullér</a>
        </div>
    </div>
</form>

@section Scripts {
<script>rr.problemForm(@(isNew ? "true" : "false"));</script>
}
