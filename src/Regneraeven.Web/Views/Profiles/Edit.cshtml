@model Profile
@{
    ViewData["Title"] = "Din profil";
    var lvl = Leveling.FromXp(Model.Xp);
    var shown = CurrentProfile.ShownTitle(Model);
    var next = Unlocks.NextAnything(lvl.Level);
    var foxCount = Unlocks.Avatars.Count(a => Unlocks.IsUnlocked(a, lvl.Level));
    var owned = CurrentProfile.OwnedStreakItems(Model);
    var frame = Unlocks.Current(UnlockKind.Frame, Model.Frame, lvl.Level, owned);
    var background = Unlocks.Current(UnlockKind.Background, Model.Background, lvl.Level, owned);
    var theme = Unlocks.Current(UnlockKind.Theme, Model.Theme, lvl.Level, owned);
    var today = DateOnly.FromDateTime(DateTime.Now);
    var streak = CurrentProfile.LiveStreak(Model, today);
    var claims = Streaks.ParseClaims(Model.StreakClaims);
    var realRewards = Streaks.ParseRewards(Model.StreakRewards);
    Microsoft.AspNetCore.Html.IHtmlContent Preview(CosmeticUnlock item) => item.Kind switch
    {
        UnlockKind.Frame => Ui.Avatar(Model.Avatar, Model.Color, "", item.Id, background.Id),
        UnlockKind.Background => Ui.Avatar(Model.Avatar, Model.Color, "", frame.Id, item.Id),
        _ => new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"swatch theme-{item.Id}\"><i></i><i></i><i></i></span>"),
    };
    // XP still needed to reach the next unlock.
    var xpToNext = 0;
    if (next is { } n)
    {
        xpToNext = lvl.XpForNextLevel - lvl.XpIntoLevel;
        for (var l = lvl.Level + 1; l < n.Level; l++) xpToNext += Leveling.XpForNext(l);
    }
}
<div class="card">
    <div class="row" style="gap:22px">
        @Ui.Avatar(Model, "xl")
        <div style="flex:1;min-width:220px">
            <h1 style="margin:0">@Model.Name</h1>
            <div class="title-name">@shown.Icon @shown.Name</div>
            <div class="muted small">Level @lvl.Level · @Model.Xp XP i alt · @Model.Grade. klasse</div>
            <div class="xpbar mt" style="max-width:360px;margin-top:8px"><i style="width:@lvl.Percent%"></i></div>
            <div class="muted small" style="margin-top:4px">@lvl.XpIntoLevel / @lvl.XpForNextLevel XP til level @(lvl.Level + 1)</div>
        </div>
        @if (next is { } nx)
        {
            <div class="next-unlock card soft" style="box-shadow:none;padding:14px 18px">
                <span style="font-size:2rem">@nx.Icon</span>
                <div>
                    <div class="small muted">Næste unlock</div>
                    <b>@nx.Text</b>
                    <div class="small">Level @nx.Level · @xpToNext XP endnu</div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card" id="unlocks">
    <div class="row between">
        <h2 style="margin:0">🎁 Mine unlocks</h2>
        <span class="badge orange">@foxCount af @Unlocks.Avatars.Count ræve låst op</span>
    </div>
    <p class="muted small">Nye ting låses op, når du stiger i level. Klik på noget, du har låst op, for at bruge det.</p>
    <h3 class="mt">🦊 Ræve</h3>
    <div class="unlocks">
        @foreach (var a in Unlocks.Avatars)
        {
            var open = Unlocks.IsUnlocked(a, lvl.Level);
            var chosen = Model.Avatar == a.Key;
            var title = Leveling.TitleFor(a.Level);
            if (open)
            {
                <form method="post" action="/profiler/avatar">
                    <input type="hidden" name="avatar" value="@a.Key">
                    <button type="submit" class="unlock @(chosen ? "chosen" : "")" title="@a.Description" style="width:100%">
                        @Ui.Avatar(a.Key, Model.Color, "", frame.Id, background.Id)
                        <b>@a.Name</b>
                        <span class="muted">@(chosen ? "✓ Bruges nu" : "Brug denne")</span>
                    </button>
                </form>
            }
            else
            {
                <div class="unlock locked-u" title="@a.Description">
                    @Ui.Avatar(a.Key, Model.Color, "", frame.Id, background.Id)
                    <b>@a.Name</b>
                    <span class="lock-badge">🔒 Låses op ved level @a.Level</span>
                    <span class="muted">@title.Icon @title.Name</span>
                </div>
            }
        }
    </div>

</div>

@foreach (var kind in new[] { UnlockKind.Frame, UnlockKind.Background, UnlockKind.Theme })
{
    var d = Unlocks.Describe(kind);
    var chosenId = kind switch { UnlockKind.Frame => frame.Id, UnlockKind.Background => background.Id, _ => theme.Id };
    var items = Unlocks.Of(kind).Concat(Streaks.Items.Where(i => i.Kind == kind)).ToList();
    <div class="card" id="@kind.ToString().ToLowerInvariant()">
        <div class="row between">
            <h2 style="margin:0">@d.Icon @d.Plural</h2>
            <span class="badge orange">@items.Count(i => Unlocks.CanUse(kind, i.Id, lvl.Level, owned)) af @items.Count låst op</span>
        </div>
        <p class="muted small">@(kind switch
        {
            UnlockKind.Frame => "En ramme om din ræv. »Klassisk« bruger din profilfarve.",
            UnlockKind.Background => "Baggrunden bag din ræv.",
            _ => "Farverne i hele Regneræven – knapper, menu og bjælker.",
        })</p>
        <div class="unlocks">
            @foreach (var item in items)
            {
                var open = Unlocks.CanUse(kind, item.Id, lvl.Level, owned);
                var chosen = item.Id == chosenId;
                var preview = Preview(item);
                if (open)
                {
                    <form method="post" action="/profiler/unlock">
                        <input type="hidden" name="kind" value="@kind">
                        <input type="hidden" name="id" value="@item.Id">
                        <button type="submit" class="unlock @(chosen ? "chosen" : "")" title="@item.Description" style="width:100%">
                            @preview
                            <b>@item.Name</b>
                            <span class="muted">@(chosen ? "✓ Bruges nu" : "Brug denne")</span>
                        </button>
                    </form>
                }
                else
                {
                    <div class="unlock locked-u" title="@item.Description">
                        @preview
                        <b>@item.Name</b>
                        <span class="lock-badge">@(item.IsStreakItem ? $"🔥 Kan vælges ved {Streaks.MilestoneFor(item)!.Days} dage i træk" : $"🔒 Låses op ved level {item.Level}")</span>
                    </div>
                }
            }
        </div>
    </div>
}

<div class="card" id="dage">
    <div class="row between">
        <h2 style="margin:0">🔥 Dage i træk</h2>
        <span class="freezes" title="En fridag dækker en glemt dag. Du får én for hver 7. dag i træk (højst @Streaks.MaxFreezes).">❄️ @Model.StreakFreezes / @Streaks.MaxFreezes fridage</span>
    </div>
    <p class="muted small">Klar alle dagens opgaver for at holde flammen i live. Ved hver milepæl får du ekstra XP og vælger selv en eksklusiv belønning.
       Glemmer du en dag, bruges en fridag automatisk.</p>
    <div class="row" style="gap:24px;margin-bottom:14px">
        <div class="row"><span class="flame @(streak == 0 ? "out" : "")">🔥</span><div><div class="flame-count">@streak</div><div class="small muted">dage i træk nu</div></div></div>
        <div><div class="flame-count">@Model.BestStreak</div><div class="small muted">din rekord</div></div>
    </div>
    <div class="milestones">
        @foreach (var m in Streaks.Milestones)
        {
            var reached = Model.BestStreak >= m.Days;
            var claimed = claims.TryGetValue(m.Days, out var chosenItem);
            var cls = claimed ? "claimed" : reached ? "ready" : "locked-m";
            <div class="milestone @cls">
                <span class="m-icon">@m.Icon</span>
                <b>@m.Days dage</b>
                <span class="small muted">+@m.BonusXp XP</span>
                @if (realRewards.TryGetValue(m.Days, out var real)) { <span class="real-reward">🎁 @real</span> }
                @if (claimed)
                {
                    var item = m.Choices.First(c => c.Id == chosenItem);
                    <span class="small">✓ Du valgte <b>@item.Name</b></span>
                }
                else if (reached)
                {
                    <span class="small" style="font-weight:700;color:#b45309">Vælg din belønning:</span>
                    <div class="choices">
                        @foreach (var c in m.Choices)
                        {
                            <form method="post" action="/profiler/dage/vaelg">
                                <input type="hidden" name="days" value="@m.Days"><input type="hidden" name="id" value="@c.Id">
                                <button type="submit" class="choice" title="@c.Description">@Preview(c)<span>@c.Name</span></button>
                            </form>
                        }
                    </div>
                }
                else
                {
                    <span class="small muted">Om @(m.Days - streak) @(m.Days - streak == 1 ? "dag" : "dage")</span>
                    <span class="small muted">@string.Join(" eller ", m.Choices.Select(c => c.Name))</span>
                }
            </div>
        }
    </div>

    <details class="mt">
        <summary style="cursor:pointer;font-weight:700">👪 For forældre: rigtige belønninger</summary>
        <p class="muted small">Skriv en belønning i den virkelige verden ved en milepæl – fx »Is på fredag« eller »Vælg aftensmad«. Den vises, når milepælen nås.</p>
        <form method="post" action="/profiler/dage/beloenninger">
            <div class="reward-inputs">
                @foreach (var m in Streaks.Milestones)
                {
                    <div>
                        <label for="reward@(m.Days)">@m.Icon @m.Days dage</label>
                        <input type="text" id="reward@(m.Days)" name="reward@(m.Days)" value="@realRewards.GetValueOrDefault(m.Days)" maxlength="80" placeholder="Fx Is på fredag" autocomplete="off">
                    </div>
                }
            </div>
            <button class="btn small mt" type="submit">Gem belønninger</button>
        </form>
    </details>
</div>

<div class="card" id="titler">
    <h2>🏅 Rævetitler</h2>
    <p class="muted small">En ny titel låses op hvert 5.–10. level. Vælg selv, hvilken titel du vil vise.</p>
    <div class="titles">
        @foreach (var t in Leveling.Titles)
        {
            var unlocked = t.Level <= lvl.Level;
            <div class="t @(unlocked ? "" : "locked-t") @(t.Level == shown.Level ? "shown" : "")" title="@t.Description">
                <div class="i">@(unlocked ? t.Icon : "🔒")</div>
                <b>@t.Name</b>
                <span class="muted small">Level @t.Level</span>
                @if (unlocked && t.Level != shown.Level)
                {
                    <form method="post" action="/profiler/titel"><input type="hidden" name="level" value="@t.Level"><button class="btn ghost small" type="submit">Vis</button></form>
                }
                else if (t.Level == shown.Level)
                {
                    <div class="small" style="color:var(--fox-dark);font-weight:700;margin-top:6px">✓ Vises</div>
                }
            </div>
        }
    </div>
</div>

<div class="grid two mt">
    <div class="card">
        <h2>Mine oplysninger</h2>
        <form method="post" action="/profiler/rediger">
            <partial name="_ProfileFields" model="Model" />
            <div class="mt"><button class="btn" type="submit">Gem</button></div>
        </form>
    </div>
    <div class="card">
        <h3>Slet profil</h3>
        <p class="muted small">Sletter @Model.Name med alle gemte opgaver, XP og unlocks. Det kan ikke fortrydes.</p>
        <form method="post" action="/profiler/slet" class="row">
            <input type="text" name="confirmName" placeholder="Skriv »@Model.Name« for at bekræfte" style="max-width:260px" autocomplete="off">
            <button class="btn danger" type="submit">Slet profil</button>
        </form>
    </div>
</div>
