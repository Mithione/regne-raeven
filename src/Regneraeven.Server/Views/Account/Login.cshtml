@model LoginForm
@{
    Layout = "_Layout";
    ViewData["Title"] = "Log ind";
}
<div class="hero mt">
    <img src="@Ui.Assets/img/fox.svg" alt="">
    <div>
        <h1>Velkommen til Regneræven</h1>
        <p class="muted">Log ind med forælderens konto. Bagefter vælger I, hvilket barn der regner.</p>
    </div>
</div>
<div class="card mt-lg" style="max-width:460px">
    @if (ViewData["Error"] is string error) { <div class="alert error">@error</div> }
    <form method="post" action="/konto/log-ind" class="stack">
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl">
        <div>
            <label class="field" for="Email">E-mail</label>
            <input type="text" id="Email" name="Email" value="@Model.Email" autocomplete="username" required autofocus>
        </div>
        <div>
            <label class="field" for="Password">Adgangskode</label>
            <input type="password" id="Password" name="Password" autocomplete="current-password" required>
        </div>
        <button class="btn big" type="submit">Log ind</button>
    </form>
    <p class="small muted mt">Ingen konto? <a href="/konto/opret">Opret en forælder-konto</a></p>
</div>
