@model RegisterForm
@inject IConfiguration Config
@{
    Layout = "_Layout";
    ViewData["Title"] = "Opret konto";
    var needsCode = !string.IsNullOrEmpty(Config["Registration:InviteCode"]);
}
<div class="hero mt">
    <img src="@Ui.Assets/img/fox.svg" alt="">
    <div>
        <h1>Opret en forælder-konto</h1>
        <p class="muted">Kontoen samler jeres børns profiler. Børnene skal ikke have deres egen e-mail.</p>
    </div>
</div>
<div class="card mt-lg" style="max-width:460px">
    @if (ViewData["Error"] is string error) { <div class="alert error">@error</div> }
    <form method="post" action="/konto/opret" class="stack">
        <div>
            <label class="field" for="Email">E-mail</label>
            <input type="text" id="Email" name="Email" value="@Model.Email" autocomplete="email" required autofocus>
        </div>
        <div>
            <label class="field" for="Password">Adgangskode <span class="muted small">(mindst 8 tegn med et tal)</span></label>
            <input type="password" id="Password" name="Password" autocomplete="new-password" required minlength="8">
        </div>
        @if (needsCode)
        {
            <div>
                <label class="field" for="InviteCode">Invitationskode</label>
                <input type="text" id="InviteCode" name="InviteCode" value="@Model.InviteCode" autocomplete="off" required>
                <div class="field-help">Regneræven er kun åben for inviterede familier.</div>
            </div>
        }
        <button class="btn big" type="submit">Opret konto</button>
    </form>
    <p class="small muted mt">Har du allerede en konto? <a href="/konto/log-ind">Log ind</a></p>
</div>
